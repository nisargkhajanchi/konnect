# Copy to .env and fill in to switch the app from demo mode to live mode.
# Both values are on the Supabase dashboard: Project Settings > API.
# The anon (publishable) key is meant to ship in the app; row-level security protects the data.
# Never put the service-role key or the Anthropic API key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
